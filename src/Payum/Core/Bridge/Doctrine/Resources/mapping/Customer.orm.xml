<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass name="Payum\Core\Model\Customer">

        <field name="customerId" column="customer_id" type="string" />

        <field name="email" column="email" type="string" nullable="true" />

        <field name="name" column="name" type="string" nullable="true" />

        <field name="gatewayCustomerIds" column="gateway_customer_ids" type="json" />

        <field name="details" column="details" type="json" />

    </mapped-superclass>
</doctrine-mapping>
