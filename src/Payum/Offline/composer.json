
{
    "name": "payum/offline",
    "type": "library",
    "description": "The Payum extension. Payments settled outside an online PSP: cash, bank transfer, store credit.",
    "keywords": [
        "payment",
        "offline",
        "invoice",
        "cash",
        "bank transfer"
    ],
    "homepage": "https://payum.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Kotlyar Maksim",
            "email": "kotlyar.maksim@gmail.com"
        },
        {
            "name":     "Payum project",
            "homepage": "https://payum.dev/"
        },
        {
            "name":     "Community contributions",
            "homepage": "https://github.com/Payum/Offline/contributors"
        }
    ],
    "require": {
        "php": "^8.1",
        "payum/core": "2.0.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "symfony/phpunit-bridge": "^8.1",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "config": {
        "bin-dir": "bin"
    },
    "autoload": {
        "psr-0": { "Payum\\Offline": "" }
    },
    "target-dir": "Payum/Offline"
}
