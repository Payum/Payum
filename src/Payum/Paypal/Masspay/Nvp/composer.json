{
    "name": "payum/paypal-masspay-nvp",
    "type": "library",
    "description": "The Payum extension. It provides Paypal Masspay integration.",
    "keywords": ["payment", "paypal", "payout", "masspay"],
    "homepage": "https://docs.payum.dev/",
    "license": "MIT",
    "authors": [
        {
            "name": "Kotlyar Maksim",
            "email": "kotlyar.maksim@gmail.com"
        },
        {
            "name":     "Payum project",
            "homepage": "https://docs.payum.dev/"
        },
        {
            "name":     "Community contributions",
            "homepage": "https://github.com/Payum/PaypalMasspayNvp/contributors"
        }
    ],
    "require": {
        "payum/core": "2.0.x-dev"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^6.0",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "config": {
        "bin-dir": "bin"
    },
    "autoload": {
        "psr-0": { "Payum\\Paypal\\Masspay\\Nvp": "" }
