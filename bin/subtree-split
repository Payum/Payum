#!/usr/bin/env bash
#
# Splits every package listed in bin/subsplits out of this repository and pushes
# it to its read-only split repository.
#
#     bin/subtree-split [branch]
#
# The branch defaults to the currently checked out one. Pushing needs an SSH key
# with write access to the Payum organisation, and splitsh-lite has to be
# installed first (bin/install-splitsh-lite). Set SPLITSH_LITE to use a binary
# from somewhere other than ./bin/splitsh-lite.

set -e
set -x

BRANCH="${1:-$(git rev-parse --abbrev-ref HEAD)}"
SPLITSH_LITE="${SPLITSH_LITE:-./bin/splitsh-lite}"
SUBSPLITS="$(dirname "$0")/subsplits"

# The split repositories are generated from this one, so the split is the only
# correct history they can have and anything else on the branch is stale. That
# happens whenever this repository's history is rewritten or a branch is
# renamed, which is why the push is forced rather than left to be rejected.
function split()
{
    # split_new_repo $1 $2
    SHA1=`$SPLITSH_LITE --prefix=$1 --origin=origin/$BRANCH`
    git push $2 "$SHA1:refs/heads/$BRANCH" -f
}

function split_new_repo()
{
    TMP_DIR="/tmp/enqueue-repo"
    REMOTE_URL=`git remote get-url $2`

    rm -rf $TMP_DIR;
    mkdir $TMP_DIR;

    (
        cd $TMP_DIR;
        git clone $REMOTE_URL .;
        git checkout -b $BRANCH;
        touch foo;
        git add foo;
        git commit -m "foo";
        git push origin $BRANCH;
    );

    SHA1=`$SPLITSH_LITE --prefix=$1`
    git fetch $2
    git push $2 "$SHA1:$BRANCH" -f
}


function remote()
{
    git remote add $1 $2 || true
}

function subsplits()
{
    grep -Ev '^[[:space:]]*(#|$)' "$SUBSPLITS"
}

while IFS='|' read -r PREFIX REMOTE REPOSITORY; do
    remote $REMOTE git@github.com:$REPOSITORY.git
done < <(subsplits)

while IFS='|' read -r PREFIX REMOTE REPOSITORY; do
    split $PREFIX $REMOTE
done < <(subsplits)
